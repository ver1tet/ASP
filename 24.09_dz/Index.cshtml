@{
    ViewData["Title"] = "Головна - Групи товарів";
}

<div class="text-center mb-4">
    <h1 class="display-4">ASP-P42</h1>
    <p class="lead text-muted">Каталог товарних груп з пагінацією</p>
</div>

<!-- Контейнер карток товарних груп -->
<div id="groups-container" class="row row-cols-1 row-cols-md-3 g-4 mb-4">
    <div class="col-12 text-center text-muted py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">Завантаження...</p>
    </div>
</div>

<!-- Пагінатор Bootstrap -->
<nav aria-label="Пагінація груп" id="pagination-nav" style="display:none;">
    <ul class="pagination justify-content-center" id="paginator">
        <!-- Генерується динамічно через renderPaginator() -->
    </ul>
</nav>

@section Scripts {
<script>
/*
 * Д.З. 24.09.2026
 * Викладач: Самойленко Денис Миколайович
 *
 * Опис завдання:
 * Покращити відображення пагінатора сторінки груп (домашньої):
 * - поточна сторінка відображається вибраною (class="page-item active")
 * - якщо поточна сторінка є першою, то кнопка назад "<<" є неактивною (class="page-item disabled")
 * - якщо поточна сторінка є останньою, то кнопка вперед ">>" є неактивною (class="page-item disabled")
 * ** якщо кількість сторінок більша за 3, то показувати поточну та сусідні << 5 [6] 7 >>
 */

let currentPage = 1;
const pageSize = 6;

// Завантаження даних із REST API /api/group
async function loadGroups(page) {
    const container = document.getElementById('groups-container');
    container.innerHTML = `
        <div class="col-12 text-center text-muted py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>`;

    try {
        const response = await fetch(`/api/group?page=${page}&pageSize=${pageSize}`);
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        const result = await response.json();

        const groups = result.data || [];
        const pagination = result.meta?.pagination || { page: 1, totalPages: 1 };

        currentPage = pagination.page;
        renderGroups(groups, container);
        renderPaginator(pagination);
    } catch (err) {
        container.innerHTML = `
            <div class="col-12 text-center text-danger py-5">
                Помилка завантаження даних: ${err.message}
            </div>`;
    }
}

// Рендеринг списку груп
function renderGroups(groups, container) {
    if (!groups || groups.length === 0) {
        container.innerHTML = `<div class="col-12 text-center text-muted py-5">Груп не знайдено</div>`;
        return;
    }

    container.innerHTML = groups.map(g => `
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="${g.imageUrl || '/img/blank.png'}"
                     class="card-img-top"
                     alt="${g.name}"
                     style="height: 180px; object-fit: cover;"
                     onerror="this.src='/img/blank.png'">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">${g.name}</h5>
                    <p class="card-text text-muted small flex-grow-1">${g.description || ''}</p>
                    <a href="/api/group/${g.slug}" class="btn btn-sm btn-outline-primary mt-2">Детальніше</a>
                </div>
            </div>
        </div>
    `).join('');
}

// ─────────────────────────────────────────────────────────────────────────────
// Головна логіка пагінатора з виконанням усіх вимог ДЗ
// ─────────────────────────────────────────────────────────────────────────────
function renderPaginator(pagination) {
    const { page, totalPages } = pagination;
    const nav = document.getElementById('pagination-nav');
    const paginator = document.getElementById('paginator');

    if (totalPages <= 1) {
        nav.style.display = 'none';
        return;
    }
    nav.style.display = '';

    // Визначення діапазону відображуваних номерів сторінок:
    // ** якщо кількість сторінок більша за 3, то показувати поточну та сусідні << 5 [6] 7 >>
    let startPage, endPage;

    if (totalPages <= 3) {
        startPage = 1;
        endPage = totalPages;
    } else {
        // Базове вікно: попередня, поточна, наступна
        startPage = page - 1;
        endPage = page + 1;

        // Обробка крайових випадків:
        // Якщо поточна сторінка 1, показуємо 1, 2, 3
        if (startPage < 1) {
            startPage = 1;
            endPage = 3;
        }
        // Якщо поточна сторінка остання, показуємо totalPages-2, totalPages-1, totalPages
        if (endPage > totalPages) {
            endPage = totalPages;
            startPage = totalPages - 2;
        }
    }

    let html = '';

    // 1. Кнопка назад "<<"
    // якщо поточна сторінка є першою, то кнопка назад "<<" є неактивною (class="page-item disabled")
    const prevDisabled = (page === 1) ? 'disabled' : '';
    html += `
        <li class="page-item ${prevDisabled}">
            <a class="page-link" href="#" data-page="${page - 1}" aria-label="Назад">
                &laquo;
            </a>
        </li>`;

    // 2. Кнопки номерів сторінок:
    // поточна сторінка відображається вибраною (class="page-item active")
    for (let i = startPage; i <= endPage; i++) {
        const activeClass = (i === page) ? 'active' : '';
        const ariaCurrent = (i === page) ? 'aria-current="page"' : '';
        html += `
        <li class="page-item ${activeClass}">
            <a class="page-link" href="#" data-page="${i}" ${ariaCurrent}>${i}</a>
        </li>`;
    }

    // 3. Кнопка вперед ">>"
    // якщо поточна сторінка є останньою, то кнопка вперед ">>" є неактивною (class="page-item disabled")
    const nextDisabled = (page === totalPages) ? 'disabled' : '';
    html += `
        <li class="page-item ${nextDisabled}">
            <a class="page-link" href="#" data-page="${page + 1}" aria-label="Вперед">
                &raquo;
            </a>
        </li>`;

    paginator.innerHTML = html;

    // Обробка кліків по сторінках
    paginator.querySelectorAll('a.page-link[data-page]').forEach(link => {
        link.addEventListener('click', e => {
            e.preventDefault();
            const parentItem = link.closest('.page-item');
            if (parentItem.classList.contains('disabled') || parentItem.classList.contains('active')) {
                return;
            }
            const targetPage = parseInt(link.dataset.page);
            if (targetPage >= 1 && targetPage <= totalPages) {
                loadGroups(targetPage);
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        });
    });
}

// Ініціалізація першої сторінки
loadGroups(currentPage);
</script>
}
